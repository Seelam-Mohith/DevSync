  "installCommand": "npm install --no-fund --no-audit",
  "buildCommand": "cd client && npm install --no-fund --no-audit && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
